<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PatchLight.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="PatchLight">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid x:Name="TitleBar" Padding="16,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="Assets/logo.png" Width="18" Height="18" />
                <TextBlock x:Name="TitleText" Text="PatchLight" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Status: the traffic light and what it means -->
            <StackPanel Padding="32,24,24,24" Spacing="20">
                <Border x:Name="LightHousing" Width="96" Padding="14" CornerRadius="30" HorizontalAlignment="Left"
                        Background="#1F2937" BorderBrush="#374151" BorderThickness="2">
                    <StackPanel Spacing="12">
                        <Ellipse x:Name="RedLamp" Width="64" Height="64" />
                        <Ellipse x:Name="YellowLamp" Width="64" Height="64" />
                        <Ellipse x:Name="GreenLamp" Width="64" Height="64" />
                    </StackPanel>
                </Border>
                <StackPanel Spacing="8">
                    <TextBlock x:Name="HeadlineText" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Name="DetailText" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Name="CheckedText" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button x:Name="CheckButton" Click="OnCheckClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock Text="Check now" />
                        </StackPanel>
                    </Button>
                    <ProgressRing x:Name="Busy" Width="20" Height="20" IsActive="False" />
                </StackPanel>
            </StackPanel>

            <!-- Pages -->
            <Grid Grid.Column="1" Padding="0,8,24,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <SelectorBar x:Name="Pages" SelectionChanged="OnPageChanged">
                    <SelectorBarItem x:Name="UpdatesPage" Text="Updates" IsSelected="True" />
                    <SelectorBarItem x:Name="HistoryPage" Text="History" />
                    <SelectorBarItem x:Name="SettingsPage" Text="Settings" />
                </SelectorBar>
                <!-- A newer PatchLight is out; stays open across pages until it's installed or closed. -->
                <InfoBar x:Name="UpdateBar" Grid.Row="1" IsOpen="False" Margin="0,8,0,0" Severity="Informational" />
                <InfoBar x:Name="Message" Grid.Row="2" IsOpen="False" Margin="0,8,0,0" />
                <ScrollViewer Grid.Row="3" Margin="0,8,0,0">
                    <StackPanel x:Name="PageContent" Spacing="10" Padding="0,4,12,24" />
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
